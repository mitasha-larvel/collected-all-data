					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Validating Status Text\", function (){\r",
							"pm.response.to.have.status(\"Created\");\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Validating whether the content-type is present in headers\",()=>{\r",
							"   pm.expect(pm.response.headers.get(\"Content-Type\")).to.include([\"application/json\"])\r",
							"});\r",
							"\r",
							"\r",
							"var jsondata = pm.response.json();\r",
							"   pm.test(\"Validating the data types of Body\", function () {\r",
							"    pm.expect(jsondata.name).to.be.a(\"string\");\r",
							"    pm.expect(jsondata.private).to.be.a(\"boolean\");\r",
							"    pm.expect(jsondata.description).to.be.a(\"string\");\r",
							"\r",
							"    var reponame = pm.response.json().name;\r",
							"pm.collectionVariables.set(\"reponame\", reponame);\r",
							"\r",
							"var repoowner = pm.response.json().owner.login;\r",
							"pm.collectionVariables.set(\"repoowner\", repoowner);\r",
							"   });"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
